<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="r2droid_ai_settings.xml"/>
        <exclude domain="file" path="ai_chat_history"/>
        <exclude domain="file" path="radare2"/>
        <exclude domain="file" path="r2work"/>
        <exclude domain="file" path="proot"/>
        <exclude domain="file" path="plugin-proot"/>
        <exclude domain="file" path="libs"/>
        <exclude domain="file" path="plugins"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="r2droid_ai_settings.xml"/>
        <exclude domain="file" path="ai_chat_history"/>
        <exclude domain="file" path="radare2"/>
        <exclude domain="file" path="r2work"/>
        <exclude domain="file" path="proot"/>
        <exclude domain="file" path="plugin-proot"/>
        <exclude domain="file" path="libs"/>
        <exclude domain="file" path="plugins"/>
    </device-transfer>
</data-extraction-rules>